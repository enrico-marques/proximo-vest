# Copie para .env.local e preencha. Nunca commite valores reais.
# Na Vercel, as variáveis do Blob vêm de `vercel env pull` depois de conectar o store.

# --- Banco (Prisma Postgres) ---
DATABASE_URL="postgres://usuario:senha@host:5432/banco?sslmode=require"

# --- Autenticação (better-auth) ---
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL pública do app (servidor e cliente)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Login com Google (OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- E-mail (Resend) ---
RESEND_API_KEY=""
MAIL_FROM="Próximo Vest <no-reply@seudominio.com.br>"

# --- Pagamentos (Stripe) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Arquivos (Vercel Blob, store PÚBLICO) ---
# Necessário para gerar os tokens de upload pelo navegador
BLOB_READ_WRITE_TOKEN=""
# Endereço público do store, sem barra no final
NEXT_PUBLIC_BLOB_BASE_URL="https://<id-do-store>.public.blob.vercel-storage.com"

# --- Legado ---
# Páginas de admin da V1 chamam a própria API pelo servidor. Some quando elas passarem a usar src/server.
API_URL="http://localhost:3000/api"

# --- Testes ---
# Banco DESCARTÁVEL para o e2e: o preparo apaga e recria dados. Nunca aponte para produção.
E2E_DATABASE_URL=""
